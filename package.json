{
  "name": "slack-acp-bridge",
  "version": "0.1.0",
  "description": "Slack (Socket Mode) bridge to ACP coding agents — one Slack thread = one agent session. Claude Code bundled; Codex, Gemini CLI and any ACP agent pluggable.",
  "keywords": [
    "slack",
    "slack-bot",
    "socket-mode",
    "acp",
    "agent-client-protocol",
    "claude",
    "claude-code",
    "coding-agent",
    "codex",
    "gemini",
    "bridge"
  ],
  "homepage": "https://github.com/biztrip-ai/slack-acp-bridge#readme",
  "bugs": {
    "url": "https://github.com/biztrip-ai/slack-acp-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biztrip-ai/slack-acp-bridge.git"
  },
  "license": "MIT",
  "author": "BizTrip AI <scottp@biztrip.ai>",
  "type": "module",
  "bin": {
    "slack-acp-bridge": "dist/index.js"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "config.example.json",
    "docs/slack-app-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke-acp.ts",
    "manifest": "node dist/index.js manifest > docs/slack-app-manifest.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run clean && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.70.0",
    "@agentclientprotocol/sdk": "^1.3.0",
    "@slack/bolt": "^4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.9",
    "vitest": "^3"
  }
}
