{
  "display_information": {
    "name": "slack-acp-bridge",
    "description": "Relay Slack threads to an ACP coding agent.",
    "background_color": "#1f2937"
  },
  "features": {
    "bot_user": {
      "display_name": "slack-acp-bridge",
      "always_online": false
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "slash_commands": [
      {
        "command": "/clear",
        "description": "Reset this thread's agent session",
        "should_escape": false
      },
      {
        "command": "/stop",
        "description": "Cancel the running turn",
        "should_escape": false
      },
      {
        "command": "/agent",
        "description": "Show or switch the agent for this thread",
        "usage_hint": "[name]",
        "should_escape": false
      },
      {
        "command": "/mode",
        "description": "Show or set the permission mode",
        "usage_hint": "[id]",
        "should_escape": false
      },
      {
        "command": "/help",
        "description": "List bridge commands",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "commands",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history",
        "im:read",
        "im:write",
        "users:read",
        "files:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
