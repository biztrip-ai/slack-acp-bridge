# --- Slack (required) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Slack-compatible server (e.g. Flow). Unset = real Slack.
#SLACK_API_URL=https://app.flowtoo.org/api/

# --- Agent ---
# Which agent new sessions use. "claude" (bundled claude-agent-acp) is built in;
# add more via AGENTS_FILE.
AGENT=claude
#AGENTS_FILE=./agents.json
# Working directory every session runs in (alias: CLAUDE_CWD).
AGENT_CWD=/path/to/repo
# ACP session mode. Claude offers default | acceptEdits | plan | bypassPermissions | auto.
# There is no approval UI in Slack yet, so the default is bypassPermissions.
PERMISSION_MODE=bypassPermissions

# --- Claude-specific passthrough (ignored by other agents) ---
#CLAUDE_MODEL=claude-opus-4-7
CLAUDE_SETTING_SOURCES=user,project,local
# Spawn claude with --chrome (Claude-in-Chrome browser MCP).
CLAUDE_CHROME=0

# --- Sessions ---
# Close agent sessions idle longer than this (seconds). 0 disables. The thread
# keeps working: the next reply re-attaches via session/load.
SESSION_IDLE_TIMEOUT_S=14400
SESSION_REAP_INTERVAL_S=300
# Where the thread→session map (sqlite) lives. Default: ~/.local/state/slack-acp-bridge
#STATE_DIR=

# debug | info | warn | error
LOG_LEVEL=info
